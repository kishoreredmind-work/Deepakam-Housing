RewriteEngine On

# 1. Automatically redirect /index.html or /index to the root domain /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?\ HTTP/ [NC]
RewriteRule ^index(\.html)?$ / [R=301,L]

# 2. Redirect other pages to remove the .html extension from the address bar
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# 3. Internally map requests back to physical .html files (except root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# Caching Rules wrapped in a safety check
<IfModule mod_headers.c>
  # 1. Disable caching for HTML files so structure updates show immediately
  <FilesMatch "\.(html|htm)$">
      Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
      Header set Expires "0"
  </FilesMatch>

  # 2. Force browser to re-validate CSS/JS assets rather than loading blindly from disk
  <FilesMatch "\.(css|js)$">
      Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
